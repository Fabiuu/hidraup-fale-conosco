# Cabeçalhos de segurança e privacidade para deployment estático portátil
# Compatível com Netlify, Cloudflare Pages, Vercel (via vercel.json), Apache, Nginx

# Todos os recursos
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# HTML - CSP restritivo (preview: connect-src https://script.google.com/macros/s/AKfycbxogrQ-0vs7o2R6cjpYbi3nA7guMphAFJ75Smad-ePzmYov1NQ_j4FrxdS-tqYVTxEV/exec https://script.googleusercontent.com apenas)
/*.html
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src https://script.google.com/macros/s/AKfycbxogrQ-0vs7o2R6cjpYbi3nA7guMphAFJ75Smad-ePzmYov1NQ_j4FrxdS-tqYVTxEV/exec https://script.googleusercontent.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Assets estáticos (logo, etc) - cache longo
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Security-Policy: default-src 'self'; img-src 'self' data:

# JavaScript - cache médio
/config.js
/app.js
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Security-Policy: default-src 'self'; script-src 'self'

# CSS - cache médio
/styles.css
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Security-Policy: default-src 'self'; style-src 'self'

# robots.txt
/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate

# ============================================================
# NOTA IMPORTANTE PARA MODO LIVE (Apps Script habilitado):
# ============================================================
# Quando config.preview = false E endpoint HTTPS válido configurado:
# 1. Altere connect-src no CSP para incluir o domínio do Apps Script:
#    connect-src https://script.google.com/macros/s/AKfycbxogrQ-0vs7o2R6cjpYbi3nA7guMphAFJ75Smad-ePzmYov1NQ_j4FrxdS-tqYVTxEV/exec https://script.googleusercontent.com https://script.google.com https://script.googleusercontent.com
#    (ou o domínio exato do seu Web App deployado)
# 
# 2. O Apps Script DEVE:
#    - Responder a OPTIONS (preflight) com Access-Control-Allow-Origin: <seu-domínio>
#    - Aceitar Content-Type: text/plain
#    - Retornar JSON: { "ok": true } com status 2xx
#    - NÃO exigir credenciais/cookies/tokens
#
# 3. Se o Apps Script redirecionar (3xx), adicione o destino final ao connect-src
# ============================================================
